pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'SOURCE_DIR',
            defaultValue: '/workspace/keploy-app',
            description: 'Use the mounted demo path, or . for an SCM checkout.'
        )
        string(
            name: 'MINIKUBE_PROFILE',
            defaultValue: 'minikube',
            description: 'Local Minikube profile name.'
        )
        choice(
            name: 'SECURITY_MODE',
            choices: ['minimal', 'caps-hostpid', 'privileged'],
            description: 'Privilege ladder for the Keploy pods. Start at minimal and step down only if eBPF fails to load.'
        )
        booleanParam(
            name: 'ENABLE_NOISE_CONFIG',
            defaultValue: true,
            description: 'Apply keploy.yml noise filtering. Uncheck to demonstrate the failure it prevents.'
        )
        string(
            name: 'TEST_DELAY',
            defaultValue: '5',
            description: 'Seconds Keploy waits for the app to boot before replaying. Use 30-60 for a JVM application.'
        )
        booleanParam(
            name: 'INJECT_REGRESSION',
            defaultValue: false,
            description: 'Break /health inside the test pod only, after recording. A RED build is the expected result: it proves Keploy detects a real change. A green build means it does not.'
        )
        string(
            name: 'RECORD_ROUNDS',
            defaultValue: '1',
            description: 'How many full recorder lifecycles to run. Each one produces its own test-set, so 2 answers "what happens if we record twice": test-set-1 appears next to test-set-0 and the replay runs both.'
        )
        string(
            name: 'TEST_ROUNDS',
            defaultValue: '1',
            description: 'How many times to replay the same recordings. Each run only adds a report directory, so 2 answers "what happens if we test twice" and proves replay is deterministic.'
        )
    }

    environment {
        APP_IMAGE = "keploy-demo-notes:${BUILD_NUMBER}"
        POSTGRES_IMAGE = 'postgres:16-alpine'
        TEST_NAMESPACE = "keploy-demo-${BUILD_NUMBER}"
        KUBECONFIG = '/var/jenkins_home/minikube-kubeconfig'
        HOST_PID = "${params.SECURITY_MODE == 'minimal' ? 'false' : 'true'}"
        SECURITY_CONTEXT = "${params.SECURITY_MODE == 'privileged' ? '{privileged: true}' : '{runAsUser: 0, capabilities: {add: [BPF, PERFMON, NET_ADMIN, SYS_RESOURCE]}}'}"
        NOISE_SETUP = "${params.ENABLE_NOISE_CONFIG ? 'true' : 'rm -f /app/keploy.yml'}"
        REGRESSION_SETUP = "${params.INJECT_REGRESSION ? 'sed -i s/ok/healthy/ /app/app.js' : 'true'}"
    }

    stages {
        stage('Verify') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        # Cleared here rather than in the Keploy Test stage: if the
                        # build dies before replaying, the post block must not
                        # archive the previous build's logs as if they were this
                        # build's evidence.
                        rm -rf "$WORKSPACE/keploy-output"
                        mkdir -p "$WORKSPACE/keploy-output"

                        test -f Dockerfile.keploy || {
                            echo "Missing $(pwd)/Dockerfile.keploy"
                            ls -la
                            exit 1
                        }
                        test -f k8s/record.yaml || {
                            echo "Missing $(pwd)/k8s/record.yaml"
                            find . -maxdepth 2 -type f -print
                            exit 1
                        }
                        test -f keploy.yml || {
                            echo "Missing $(pwd)/keploy.yml"
                            exit 1
                        }
                        docker version
                        kubectl version --client
                        kubectl --context "$MINIKUBE_PROFILE" get nodes
                    '''
                }
            }
        }

        stage('Build App') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        BUILD_STATUS=1
                        for attempt in 1 2 3; do
                            if docker build -f Dockerfile.keploy -t "$APP_IMAGE" .; then
                                BUILD_STATUS=0
                                break
                            fi
                            echo "Docker build attempt $attempt failed; retrying in 10 seconds"
                            sleep 10
                        done
                        test "$BUILD_STATUS" -eq 0
                        docker save "$APP_IMAGE" | docker exec -i minikube docker load

                        # Preloaded the same way as the app image so the Minikube
                        # node never needs registry access of its own.
                        docker pull "$POSTGRES_IMAGE"
                        docker save "$POSTGRES_IMAGE" | docker exec -i minikube docker load
                    '''
                }
            }
        }

        stage('Keploy Record') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        echo "Security mode: $SECURITY_MODE (hostPID=$HOST_PID, securityContext=$SECURITY_CONTEXT)"
                        echo "Noise config enabled: $ENABLE_NOISE_CONFIG"
                        echo "Regression injected: $INJECT_REGRESSION"
                        echo "Record rounds: $RECORD_ROUNDS"

                        kubectl --context "$MINIKUBE_PROFILE" create namespace "$TEST_NAMESPACE"

                        # A test-set is closed when the recorder shuts down, not
                        # when traffic stops. Sending the same requests twice into
                        # one running recorder would only append cases to
                        # test-set-0; a second test-set needs a second lifecycle,
                        # which is why the whole apply/drive/delete block is what
                        # repeats here.
                        for round in $(seq 1 "$RECORD_ROUNDS"); do
                        echo "===== Record round $round of $RECORD_ROUNDS ====="
                        sed -e "s|__APP_IMAGE__|$APP_IMAGE|g" \
                            -e "s|__HOST_PID__|$HOST_PID|g" \
                            -e "s|__SECURITY_CONTEXT__|$SECURITY_CONTEXT|g" \
                            -e "s|__NOISE_SETUP__|$NOISE_SETUP|g" \
                            k8s/record.yaml \
                          | kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" apply -f -
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          rollout status deployment/postgres --timeout=180s

                        if ! kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          rollout status deployment/keploy-recorder --timeout=180s; then
                            echo "Keploy recorder did not become ready"
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get pods,pvc -o wide || true
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" describe deployment/keploy-recorder || true
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" describe pods || true
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" logs deployment/keploy-recorder --all-containers --tail=-1 || true
                            exit 1
                        fi

                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" run "keploy-traffic-$round" \
                          --rm -i --restart=Never \
                          --image="$APP_IMAGE" --image-pull-policy=Never \
                          --env=TARGET_URL=http://keploy-notes:8080 \
                          --command -- node -e '
                            const base = process.env.TARGET_URL;
                            async function request(path, options = {}) {
                              const response = await fetch(base + path, options);
                              if (!response.ok) throw new Error(`${options.method || "GET"} ${path}: ${response.status}`);
                            }
                            async function main() {
                              let ready = false;
                              for (let attempt = 0; attempt < 30; attempt += 1) {
                                try {
                                  await request("/health");
                                  ready = true;
                                  break;
                                } catch (error) {
                                  await new Promise((resolve) => setTimeout(resolve, 2000));
                                }
                              }
                              if (!ready) throw new Error("Application did not become ready");
                              await request("/notes");
                              await request("/notes", {
                                method: "POST",
                                headers: { "content-type": "application/json" },
                                body: JSON.stringify({ title: "Minikube note", content: "Recorded by Keploy" })
                              });
                              await request("/notes/1");
                            }
                            main().catch((error) => { console.error(error); process.exit(1); });
                          '

                        sleep 5
                        # Deleting the recorder is what makes Keploy flush the
                        # test files. Reading the volume before this point shows
                        # an empty or partial test-set.
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          delete deployment keploy-recorder --timeout=60s

                        # Nothing else in the namespace mounts the recording volume
                        # once the recorder is gone, so this pod exists purely to
                        # keep it readable. It outlives the whole build: the post
                        # block copies the real files out through it after the
                        # replay has added its reports. The overrides JSON is only
                        # here to attach the PVC, which plain kubectl run flags
                        # cannot express.
                        if ! kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get pod keploy-dump >/dev/null 2>&1; then
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" run keploy-dump \
                              --restart=Never \
                              --image="$APP_IMAGE" --image-pull-policy=Never \
                              --overrides='{"spec":{"volumes":[{"name":"keploy-data","persistentVolumeClaim":{"claimName":"keploy-data"}}],"containers":[{"name":"dump","image":"'"$APP_IMAGE"'","imagePullPolicy":"Never","volumeMounts":[{"name":"keploy-data","mountPath":"/data","readOnly":true}],"command":["sleep","infinity"]}]}}'
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                              wait --for=condition=Ready pod/keploy-dump --timeout=120s
                        fi

                        # Dumped per round on purpose: after round 1 the volume
                        # holds test-set-0, after round 2 it holds test-set-0 and
                        # test-set-1. The difference between the two logs is the
                        # answer to "what does recording twice do".
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" exec pod/keploy-dump \
                          -- sh -c 'ls -lR /data/keploy; echo ===== TEST CASES =====; for f in /data/keploy/test-set-*/tests/*.yaml; do echo FILE: $f; cat $f; done; echo ===== MOCK KINDS =====; grep -h ^kind: /data/keploy/test-set-*/mocks.yaml | sort | uniq -c' \
                          | tee "$WORKSPACE/keploy-output/record-round-$round.log"
                        done

                        # Torn down after the last round, before any replay. The
                        # test manifest never creates Postgres, but until this
                        # existed the Deployment and Service from record.yaml
                        # survived into the replay: app.js defaults to host
                        # "postgres", the name still resolved, and the real
                        # database still accepted connections. Replay very likely
                        # served everything from mocks anyway, but nothing proved
                        # it, and a query that failed to match a mock could reach
                        # the real database and turn a broken mock green.
                        # Removing it is what makes "no database in the replay
                        # environment" a checked fact rather than an assumption.
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          delete deployment/postgres service/postgres --timeout=60s
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get pods,svc
                    '''
                }
            }
        }

        stage('Keploy Test') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        echo "Test rounds: $TEST_ROUNDS"

                        # The job log is the only durable record of what Keploy
                        # produced: the namespace and its volume are destroyed in
                        # the post block. Written under WORKSPACE rather than
                        # SOURCE_DIR because archiveArtifacts resolves paths there.
                        mkdir -p "$WORKSPACE/keploy-output"

                        OVERALL=0
                        for run in $(seq 1 "$TEST_ROUNDS"); do
                        echo "===== Test run $run of $TEST_ROUNDS ====="
                        sed -e "s|__APP_IMAGE__|$APP_IMAGE|g" \
                            -e "s|__HOST_PID__|$HOST_PID|g" \
                            -e "s|__SECURITY_CONTEXT__|$SECURITY_CONTEXT|g" \
                            -e "s|__NOISE_SETUP__|$NOISE_SETUP|g" \
                            -e "s|__REGRESSION_SETUP__|$REGRESSION_SETUP|g" \
                            -e "s|__TEST_DELAY__|$TEST_DELAY|g" \
                            -e "s|__RUN_ID__|$run|g" \
                            k8s/test.yaml \
                          | kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" apply -f -

                        TEST_STATUS=1
                        for attempt in $(seq 1 120); do
                            SUCCEEDED="$(kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get job "keploy-test-$run" -o jsonpath='{.status.succeeded}')"
                            FAILED="$(kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get job "keploy-test-$run" -o jsonpath='{.status.failed}')"
                            if [ "$SUCCEEDED" = "1" ]; then
                                TEST_STATUS=0
                                break
                            fi
                            if [ "$FAILED" = "1" ]; then
                                break
                            fi
                            sleep 2
                        done

                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          logs "job/keploy-test-$run" > "$WORKSPACE/keploy-output/test-run-$run.log" 2>&1 || true
                        cat "$WORKSPACE/keploy-output/test-run-$run.log"

                        if [ "$TEST_STATUS" -ne 0 ]; then
                            OVERALL=1
                        fi

                        # Every round is driven to completion even after a failure,
                        # so a two-round comparison still has both logs to compare.
                        # Deleting the Job frees the keploy-notes Service for the
                        # next round's pod.
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          delete job "keploy-test-$run" --timeout=60s || true
                        done

                        exit "$OVERALL"
                    '''
                }
            }
        }
    }

    post {
        always {
            // Copied through the parking pod rather than reprinted into a log:
            // this is the volume itself, so the archive contains the real
            // test-set yaml files, mocks.yaml and the replay reports as browsable
            // files. Runs before the namespace teardown below and tolerates a
            // missing pod, because a build that died during Build App never
            // created one.
            sh '''
                set -u
                mkdir -p "$WORKSPACE/keploy-output"
                if kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get pod keploy-dump >/dev/null 2>&1; then
                    kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                      cp keploy-dump:/data/keploy "$WORKSPACE/keploy-output/keploy-volume" || true
                    echo "===== Archived volume tree ====="
                    find "$WORKSPACE/keploy-output/keploy-volume" -type f | sort || true
                else
                    echo "No keploy-dump pod in $TEST_NAMESPACE; nothing to copy."
                fi
            '''

            // On red builds too: an injected regression is exactly when the
            // recorded cases and the failure diff are worth keeping.
            archiveArtifacts artifacts: 'keploy-output/**', allowEmptyArchive: true, fingerprint: false

            sh '''
                kubectl --context "$MINIKUBE_PROFILE" delete namespace "$TEST_NAMESPACE" --ignore-not-found --wait=false || true
                docker exec minikube docker image rm "$APP_IMAGE" >/dev/null 2>&1 || true
                docker image rm "$APP_IMAGE" >/dev/null 2>&1 || true
            '''
        }
    }
}
