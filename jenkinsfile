pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'SOURCE_DIR',
            defaultValue: '/workspace/keploy-app',
            description: 'Use the mounted demo path, or . for an SCM checkout.'
        )
        string(
            name: 'MINIKUBE_PROFILE',
            defaultValue: 'minikube',
            description: 'Local Minikube profile name.'
        )
        choice(
            name: 'SECURITY_MODE',
            choices: ['minimal', 'caps-hostpid', 'privileged'],
            description: 'Privilege ladder for the Keploy pods. Start at minimal and step down only if eBPF fails to load.'
        )
        booleanParam(
            name: 'ENABLE_NOISE_CONFIG',
            defaultValue: true,
            description: 'Apply keploy.yml noise filtering. Uncheck to demonstrate the failure it prevents.'
        )
        string(
            name: 'TEST_DELAY',
            defaultValue: '5',
            description: 'Seconds Keploy waits for the app to boot before replaying. Use 30-60 for a JVM application.'
        )
        booleanParam(
            name: 'INJECT_REGRESSION',
            defaultValue: false,
            description: 'Break /health inside the test pod only, after recording. A RED build is the expected result: it proves Keploy detects a real change. A green build means it does not.'
        )
    }

    environment {
        APP_IMAGE = "keploy-demo-notes:${BUILD_NUMBER}"
        TEST_NAMESPACE = "keploy-demo-${BUILD_NUMBER}"
        KUBECONFIG = '/var/jenkins_home/minikube-kubeconfig'
        HOST_PID = "${params.SECURITY_MODE == 'minimal' ? 'false' : 'true'}"
        SECURITY_CONTEXT = "${params.SECURITY_MODE == 'privileged' ? '{privileged: true}' : '{runAsUser: 0, capabilities: {add: [BPF, PERFMON, NET_ADMIN, SYS_RESOURCE]}}'}"
        NOISE_SETUP = "${params.ENABLE_NOISE_CONFIG ? 'true' : 'rm -f /app/keploy.yml'}"
        REGRESSION_SETUP = "${params.INJECT_REGRESSION ? 'sed -i s/ok/healthy/ /app/app.js' : 'true'}"
    }

    stages {
        stage('Verify') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        test -f Dockerfile.keploy || {
                            echo "Missing $(pwd)/Dockerfile.keploy"
                            ls -la
                            exit 1
                        }
                        test -f k8s/record.yaml || {
                            echo "Missing $(pwd)/k8s/record.yaml"
                            find . -maxdepth 2 -type f -print
                            exit 1
                        }
                        test -f keploy.yml || {
                            echo "Missing $(pwd)/keploy.yml"
                            exit 1
                        }
                        docker version
                        kubectl version --client
                        kubectl --context "$MINIKUBE_PROFILE" get nodes
                    '''
                }
            }
        }

        stage('Build App') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        BUILD_STATUS=1
                        for attempt in 1 2 3; do
                            if docker build -f Dockerfile.keploy -t "$APP_IMAGE" .; then
                                BUILD_STATUS=0
                                break
                            fi
                            echo "Docker build attempt $attempt failed; retrying in 10 seconds"
                            sleep 10
                        done
                        test "$BUILD_STATUS" -eq 0
                        docker save "$APP_IMAGE" | docker exec -i minikube docker load
                    '''
                }
            }
        }

        stage('Keploy Record') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        echo "Security mode: $SECURITY_MODE (hostPID=$HOST_PID, securityContext=$SECURITY_CONTEXT)"
                        echo "Noise config enabled: $ENABLE_NOISE_CONFIG"
                        echo "Regression injected: $INJECT_REGRESSION"

                        kubectl --context "$MINIKUBE_PROFILE" create namespace "$TEST_NAMESPACE"
                        sed -e "s|__APP_IMAGE__|$APP_IMAGE|g" \
                            -e "s|__HOST_PID__|$HOST_PID|g" \
                            -e "s|__SECURITY_CONTEXT__|$SECURITY_CONTEXT|g" \
                            -e "s|__NOISE_SETUP__|$NOISE_SETUP|g" \
                            k8s/record.yaml \
                          | kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" apply -f -
                        if ! kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          rollout status deployment/keploy-recorder --timeout=180s; then
                            echo "Keploy recorder did not become ready"
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get pods,pvc -o wide || true
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" describe deployment/keploy-recorder || true
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" describe pods || true
                            kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" logs deployment/keploy-recorder --all-containers --tail=-1 || true
                            exit 1
                        fi

                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" run keploy-traffic \
                          --rm -i --restart=Never \
                          --image="$APP_IMAGE" --image-pull-policy=Never \
                          --env=TARGET_URL=http://keploy-notes:8080 \
                          --command -- node -e '
                            const base = process.env.TARGET_URL;
                            async function request(path, options = {}) {
                              const response = await fetch(base + path, options);
                              if (!response.ok) throw new Error(`${options.method || "GET"} ${path}: ${response.status}`);
                            }
                            async function main() {
                              let ready = false;
                              for (let attempt = 0; attempt < 30; attempt += 1) {
                                try {
                                  await request("/health");
                                  ready = true;
                                  break;
                                } catch (error) {
                                  await new Promise((resolve) => setTimeout(resolve, 2000));
                                }
                              }
                              if (!ready) throw new Error("Application did not become ready");
                              await request("/notes");
                              await request("/notes", {
                                method: "POST",
                                headers: { "content-type": "application/json" },
                                body: JSON.stringify({ title: "Minikube note", content: "Recorded by Keploy" })
                              });
                              await request("/notes/1");
                            }
                            main().catch((error) => { console.error(error); process.exit(1); });
                          '

                        sleep 5
                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" \
                          delete deployment keploy-recorder --timeout=60s
                    '''
                }
            }
        }

        stage('Keploy Test') {
            steps {
                dir("${params.SOURCE_DIR}") {
                    sh '''
                        set -eu
                        sed -e "s|__APP_IMAGE__|$APP_IMAGE|g" \
                            -e "s|__HOST_PID__|$HOST_PID|g" \
                            -e "s|__SECURITY_CONTEXT__|$SECURITY_CONTEXT|g" \
                            -e "s|__NOISE_SETUP__|$NOISE_SETUP|g" \
                            -e "s|__REGRESSION_SETUP__|$REGRESSION_SETUP|g" \
                            -e "s|__TEST_DELAY__|$TEST_DELAY|g" \
                            k8s/test.yaml \
                          | kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" apply -f -

                        TEST_STATUS=1
                        for attempt in $(seq 1 120); do
                            SUCCEEDED="$(kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get job keploy-test -o jsonpath='{.status.succeeded}')"
                            FAILED="$(kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" get job keploy-test -o jsonpath='{.status.failed}')"
                            if [ "$SUCCEEDED" = "1" ]; then
                                TEST_STATUS=0
                                break
                            fi
                            if [ "$FAILED" = "1" ]; then
                                break
                            fi
                            sleep 2
                        done

                        kubectl --context "$MINIKUBE_PROFILE" -n "$TEST_NAMESPACE" logs job/keploy-test || true
                        exit "$TEST_STATUS"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                kubectl --context "$MINIKUBE_PROFILE" delete namespace "$TEST_NAMESPACE" --ignore-not-found --wait=false || true
                docker exec minikube docker image rm "$APP_IMAGE" >/dev/null 2>&1 || true
                docker image rm "$APP_IMAGE" >/dev/null 2>&1 || true
            '''
        }
    }
}
